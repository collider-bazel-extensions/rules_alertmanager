"""Private build files for rules_alertmanager. Public surface lives in
//:defs.bzl, which re-exports from here."""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load(":config.bzl", "alertmanager_config")

package(default_visibility = ["//visibility:public"])

exports_files([
    "alertmanager_test_trampoline.sh",
    "check_config.sh",
    "versions.bzl",
    "health_check.sh.tmpl",
    "install_config.awk",
    "launcher.py",
    "routes_test.sh.tmpl",
    "server.sh.tmpl",
    "testlib.sh",
    "webhook_sink.py",
])

sh_binary(
    name = "check_config",
    srcs = ["check_config.sh"],
)

# alertmanager_server's default: one receiver, no notifiers.
alertmanager_config(
    name = "default_config",
    src = "default_config.yml",
)

# alertmanager_test's default with webhook_sink = True.
alertmanager_config(
    name = "default_test_config",
    src = "default_test_config.yml",
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "config",
    srcs = ["config.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "server",
    srcs = ["server.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "test",
    srcs = ["test.bzl"],
    deps = [":server"],
)

bzl_library(
    name = "install",
    srcs = ["install.bzl"],
    deps = [":providers"],
)
